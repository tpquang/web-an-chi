# API chỉ được gọi từ server của Next
API_URL=http://localhost:4000
# Domain thật của site, dùng cho canonical, sitemap, robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chỉ bản chính thức đặt "on". Bỏ trống hoặc giá trị khác thì toàn site noindex
SITE_INDEXING=
# Tên miền chứa ảnh sản phẩm, cách nhau bằng dấu phẩy, ví dụ cdn.anchi.vn
IMAGE_HOSTNAMES=
# Mã đo GA4 (G-XXXX). Chỉ nạp khi SITE_INDEXING=on
NEXT_PUBLIC_GA_ID=
# Mã xác minh Search Console dạng thẻ meta (chỉ phần content), khi không xác minh qua DNS
GOOGLE_SITE_VERIFICATION=
# Google Tag Manager (GTM-XXXX). Có mã này thì bỏ qua NEXT_PUBLIC_GA_ID, thẻ GA4 đặt trong GTM
NEXT_PUBLIC_GTM_ID=
