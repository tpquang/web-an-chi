NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://anchi:anchi_dev@localhost:5433/anchi
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Tài khoản đăng nhập CMS. Đổi cả ba giá trị ở môi trường thật
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=anchi-dev-123
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, tạo bằng: openssl rand -hex 32
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Bật nút "Đăng nhập nhanh" trên CMS khi dev. Không có tác dụng khi NODE_ENV=production
DEV_LOGIN=on
