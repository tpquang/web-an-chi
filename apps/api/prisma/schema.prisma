generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  // Hướng dẫn chọn hiển thị dưới lưới sản phẩm, mỗi đoạn cách nhau một dòng trống
  guide           String?
  position        Int       @default(0)
  metaTitle       String?
  metaDescription String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Kinh doanh: bán trên web. Phát sinh: đóng gói nội bộ như hộp ship, không bán.
// Vòng xâu hạt: giá tính theo công thức hạt, chỉ có giá sau khi đóng xong
enum ProductType {
  RETAIL
  SUPPLY
  CUSTOM
}

model Product {
  id                String             @id @default(cuid())
  name              String
  type              ProductType        @default(RETAIL)
  slug              String             @unique
  // Một câu ngắn hiện cạnh giá
  summary           String?
  description       String?
  usage             String?
  // Thông số dạng [{ "label": "Kích thước hạt", "value": "12mm" }]
  specs             Json?
  // Giá lưu bằng số nguyên VND. 0 là chưa định giá: chưa bán được dù đã đăng
  priceVnd          Int                @default(0)
  compareAtPriceVnd Int?
  stock             Int                @default(0)
  // Xuất xứ, ví dụ "Khánh Hòa"; để trống khi chưa xác minh được
  origin            String?
  // Hiện ở mục sản phẩm nổi bật trang chủ, tối đa 4 sản phẩm
  featured          Boolean            @default(false)
  // Link gian hàng của chính sản phẩm này trên sàn, để trống nếu không bán ở đó
  shopeeUrl         String?
  tiktokUrl         String?
  status            PublishStatus      @default(DRAFT)
  metaTitle         String?
  metaDescription   String?
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  orderItems        OrderItem[]
  posts             Post[]
  components        ProductComponent[]
  batchPlans        BatchPlan[]
  movements         StockMovement[]
  packRuns          PackRun[]
  // Giá vốn bình quân mỗi sản phẩm đã đóng gói, cập nhật mỗi lần đóng gói
  unitCostVnd       Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model PostCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  position        Int      @default(0)
  metaTitle       String?
  metaDescription String?
  posts           Post[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Post {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  // Văn bản thuần: đoạn cách nhau một dòng trống, "# " là H1, "## " là H2, "### " là H3, "- " là gạch đầu dòng,
  // ảnh một dòng riêng dạng ![alt](url "chú thích dưới ảnh")
  content         String
  coverUrl        String?
  coverAlt        String?
  // Từ khoá chính để chấm điểm SEO trong CMS
  focusKeyword    String?
  // Ảnh và chữ khi chia sẻ lên mạng xã hội. Để trống thì dùng tiêu đề, mô tả, ảnh bìa
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  authorName      String
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  categoryId      String
  category        PostCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Sản phẩm liên quan hiện cuối bài
  products        Product[]
  // Hiện ở mục bài viết nổi bật trang chủ, tối đa 3 bài
  featured        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Customer {
  id               String         @id @default(cuid())
  name             String
  // Khoá nhận diện khách đặt hàng không cần tài khoản
  phone            String         @unique
  email            String?
  address          String?
  // Chỉ true khi khách tự đánh dấu đồng ý nhận tin
  marketingConsent Boolean        @default(false)
  conversations    Conversation[]
  // null: khách chỉ đặt hàng, chưa tạo tài khoản. Dạng "scrypt$<salt>$<hash>"
  passwordHash     String?
  orders           Order[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  // Client gửi kèm mỗi lần đặt để bấm hai lần không tạo hai đơn
  idempotencyKey  String?       @unique
  // Thông tin giao hàng lưu theo đơn, không đổi khi khách cập nhật hồ sơ
  customerName    String
  customerPhone   String
  customerEmail   String?
  address         String
  note            String?
  subtotalVnd     Int
  shippingVnd     Int
  totalVnd        Int
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  // Ngày nhận tiền thật, nhập tay khi đối soát
  paidAt          DateTime?
  status          OrderStatus   @default(PENDING)
  channel         SalesChannel  @default(WEB)
  // Mã đơn bên sàn, để đối soát
  externalCode    String?
  // Phí sàn, phí thanh toán của đơn, nhập tay
  platformFeeVnd  Int           @default(0)
  // Tiền ship thực trả cho đơn vị vận chuyển, nhập tay. shippingVnd là tiền ship thu của khách
  shippingCostVnd Int           @default(0)
  // Nhân viên nhập đơn ở CMS. Đơn khách tự đặt trên web thì trống
  createdById     String?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id           String   @id @default(cuid())
  // Lưu lại tên và giá lúc đặt để đơn cũ không đổi khi sản phẩm thay đổi hoặc bị xóa
  productName  String
  unitPriceVnd Int
  quantity     Int
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Giá vốn mỗi đơn vị lúc đặt, để tính lợi nhuận đúng kể cả khi giá vốn đổi sau này
  unitCostVnd  Float    @default(0)
  // Vòng tự thiết kế: danh sách hạt, dây, cỡ tay, dịch vụ thêm tại lúc đặt
  design       Json?

  @@index([orderId])
  @@index([productId])
}

// Cấu hình cửa hàng dạng khoá - giá trị, ví dụ "store" chứa thông tin liên hệ, tài khoản ngân hàng
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---- Kho và đợt nhập hàng
// Nhập nguyên liệu thô (nụ, hộp, túi...), đóng gói theo công thức thành sản phẩm bán (Product.stock).
// Mọi thay đổi tồn kho ghi vào StockMovement. Số lượng tính theo đơn vị gốc của nguyên liệu.

// Hạt trầm và charm nhập theo số lượng (viên, cái), không quy đổi kg
enum MaterialKind {
  GENERAL
  BEAD
  CHARM
}

// Nhóm hàng hoá để chia khi nhập hàng
enum MaterialGroup {
  // Hộp, túi zip, túi quà
  PACKAGING
  // Hạt trầm, charm
  BEAD
  // Nụ trầm các loại: nụ to, nụ nhỏ, nụ khuôn khác
  CONE
  // Nhang các loại: nhang thường, nhang nhũ
  STICK
  // Hàng mua về bán nguyên như lư hương
  PRODUCT
  // Vật tư tiêu hao như hộp ship, dây: trừ bằng kiểm kho, không vào giá thành sản phẩm
  CONSUMABLE
}

model Material {
  id           String             @id @default(cuid())
  name         String             @unique
  group        MaterialGroup      @default(PACKAGING)
  kind         MaterialKind       @default(GENERAL)
  // Hạt trầm: loại trầm dùng chung ảnh vân, trùng Bead.material và BeadTexture.material
  beadMaterial String?
  // Charm: file 3D .glb để dựng charm trên vòng
  model        MaterialModel?
  // Đơn vị gốc: viên, cái, gam...
  unit         String
  // Quy đổi để nhập theo kg, ví dụ 800 viên mỗi kg. Để trống nếu không nhập theo kg
  unitsPerKg   Int?
  stock        Int                @default(0)
  // Giá vốn bình quân mỗi đơn vị, cập nhật mỗi lần nhập kho
  avgCostVnd   Float              @default(0)
  // Lãi trên giá vốn, phần trăm. Có thì giá bán hạt, charm tự cập nhật mỗi lần nhập kho
  markupPct    Float?
  beads        Bead[]
  note         String?
  components   ProductComponent[]
  lines        PurchaseLine[]
  writeOffs    BatchWriteOff[]
  movements    StockMovement[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// Công thức đóng gói: một sản phẩm bán gồm bao nhiêu đơn vị của từng nguyên liệu
model ProductComponent {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Int
  position   Int      @default(0)

  @@unique([productId, materialId])
}

enum BatchStatus {
  PLANNED
  ORDERED
  RECEIVED
}

model PurchaseBatch {
  id         String          @id @default(cuid())
  name       String
  supplier   String?
  orderedAt  DateTime?
  receivedAt DateTime?
  status     BatchStatus     @default(PLANNED)
  // Vốn đang có cho đợt này, để so với vốn cần
  capitalVnd Int?
  // Phí bán ước tính trên doanh thu (sàn, thanh toán), phần trăm
  feePct     Float           @default(0)
  note       String?
  lines      PurchaseLine[]
  extras     PurchaseExtra[]
  writeOffs  BatchWriteOff[]
  plans      BatchPlan[]
  movements  StockMovement[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([createdAt])
}

// Một dòng nguyên liệu trong đợt nhập
model PurchaseLine {
  id            String        @id @default(cuid())
  batchId       String
  batch         PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  position      Int           @default(0)
  // Số lượng theo đơn vị gốc của nguyên liệu
  quantity      Int
  // Thành tiền của dòng
  totalCostVnd  Int
  // Chỉ để hiển thị lại khi nhập theo kg
  inputKg       Float?
  pricePerKgVnd Int?

  @@index([batchId, position])
}

// Chi phí phát sinh của đợt nhập: ship nhập, thuế... chia vào giá vốn theo tỉ lệ tiền hàng
model PurchaseExtra {
  id        String        @id @default(cuid())
  batchId   String
  batch     PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position  Int           @default(0)
  label     String
  amountVnd Int
  // true: chia vào giá vốn nguyên liệu (ship nhập, thuế). false: chi phí khác như khấu hao, tính tỉ lệ riêng
  allocate  Boolean       @default(true)
  note      String?

  @@index([batchId, position])
}

// Hao hụt khi nhận hàng: móp, vỡ, ẩm, tiêu huỷ. Không vào kho, chi phí dồn vào phần còn lại
model BatchWriteOff {
  id         String        @id @default(cuid())
  batchId    String
  batch      PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId String
  material   Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Int
  reason     String
  position   Int           @default(0)
}

// Dự kiến đóng bao nhiêu thành phẩm từ đợt nhập, để tính lợi nhuận trước khi nhập kho
model BatchPlan {
  id        String        @id @default(cuid())
  batchId   String
  batch     PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([batchId, productId])
}

enum MovementType {
  PURCHASE
  WRITE_OFF
  PACK_CONSUME
  PACK_PRODUCE
  ADJUST
  // Bán: đơn web hoặc đơn nhập tay trừ kho
  SALE
  // Huỷ đơn trả lại kho
  RETURN
}

// Sổ kho: quantity dương là tăng, âm là giảm
model StockMovement {
  id          String         @id @default(cuid())
  type        MovementType
  materialId  String?
  material    Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Int
  unitCostVnd Float          @default(0)
  batchId     String?
  batch       PurchaseBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  packRunId   String?
  packRun     PackRun?       @relation(fields: [packRunId], references: [id], onDelete: SetNull)
  orderId     String?
  note        String?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([materialId, createdAt])
  @@index([productId, createdAt])
}

// Một lần đóng gói thành phẩm
model PackRun {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitCostVnd Float
  note        String?
  movements   StockMovement[]
  createdAt   DateTime        @default(now())

  @@index([createdAt])
}

// ---- Nhân viên và chăm sóc khách hàng

enum StaffRole {
  // Chủ shop: toàn quyền, kể cả vốn, kho, nhân viên
  OWNER
  // Bán hàng: hộp thư, đơn hàng, khách hàng, sản phẩm, bài viết
  SALES
}

model StaffUser {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          StaffRole      @default(SALES)
  // Ma trận quyền của nhân viên: { "orders": "edit", "finance": "none", ... }. Chủ shop luôn đủ quyền
  permissions   Json?
  active        Boolean        @default(true)
  conversations Conversation[]
  messages      ChatMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum ChatChannel {
  WEB
  FACEBOOK
  ZALO
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id                String             @id @default(cuid())
  channel           ChatChannel        @default(WEB)
  // Mã bí mật của trình duyệt khách (đã băm), lưu trong cookie httpOnly của web
  visitorKeyHash    String?            @unique
  name              String
  phone             String?
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status            ConversationStatus @default(OPEN)
  assigneeId        String?
  assignee          StaffUser?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  tags              String[]           @default([])
  note              String?
  // Trang khách đang xem khi bắt đầu chat
  pageUrl           String?
  unreadForStaff    Int                @default(0)
  unreadForCustomer Int                @default(0)
  lastMessageAt     DateTime           @default(now())
  lastMessage       String?
  messages          ChatMessage[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, lastMessageAt])
  @@index([assigneeId, lastMessageAt])
}

enum MessageSender {
  CUSTOMER
  STAFF
  SYSTEM
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  staffId        String?
  staff          StaffUser?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

// Câu trả lời mẫu, gõ "/" trong ô chat để chèn
model QuickReply {
  id       String @id @default(cuid())
  title    String
  body     String
  position Int    @default(0)
}

// Hạt và charm dùng ở trang tự thiết kế vòng, tồn kho tính theo viên
enum BeadKind {
  BEAD
  CHARM
}

model Bead {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  kind       BeadKind  @default(BEAD)
  material   String
  sizeMm     Float
  priceVnd   Int
  // Màu và độ bóng để dựng 3D khi chưa có ảnh thật
  color      String
  finish     String    @default("wood")
  // Nguyên liệu trong kho tương ứng. Tồn kho hạt là tồn kho của nguyên liệu này, giá vốn cũng lấy ở đây
  materialId String?
  stockItem  Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  note       String?
  active     Boolean   @default(true)
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, position])
}

// Ảnh vân vật liệu cho hạt 3D, dùng chung cho mọi hạt cùng chất liệu (trùng Bead.material).
// Ảnh vuông 1024px đã cắt và nén ở CMS, nhỏ nên lưu thẳng trong database cho khỏi lo chỗ chứa file.
model BeadTexture {
  id        String   @id @default(cuid())
  material  String   @unique
  image     Bytes
  mime      String
  // 0 là bóng như gương, 1 là mờ hẳn
  roughness Float    @default(0.5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ảnh banner và slide trang chủ, tải lên từ CMS. Đã nén ở CMS, lưu thẳng trong database như ảnh vân hạt.
// Setting "home" giữ id ảnh; ảnh không còn được dùng thì xoá khi lưu cấu hình trang chủ.
enum SalesChannel {
  WEB
  SHOPEE
  TIKTOK
  // Khách quen, giới thiệu, nhập tay ở CMS
  REFERRAL
  OTHER
}

// Ảnh sản phẩm, ảnh bài viết tải lên từ CMS. Tách khỏi SiteImage vì ảnh trang chủ tự dọn khi không dùng
model MediaImage {
  id        String   @id @default(cuid())
  image     Bytes
  mime      String
  width     Int
  height    Int
  size      Int
  fileName  String?
  createdAt DateTime @default(now())
}

model SiteImage {
  id        String   @id @default(cuid())
  image     Bytes
  mime      String
  width     Int
  height    Int
  createdAt DateTime @default(now())
}

// File 3D .glb của charm. Bảng riêng để danh sách nguyên liệu không phải đọc cả file
model MaterialModel {
  id         String   @id @default(cuid())
  materialId String   @unique
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  data       Bytes
  fileName   String
  size       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---- Chi phí phát sinh: mặt bằng, lương, quảng cáo, khấu hao... trừ vào lợi nhuận theo tháng
model Expense {
  id        String   @id @default(cuid())
  // Ngày phát sinh, quyết định chi phí tính vào tháng nào
  spentAt   DateTime
  // Nhóm tự do, ví dụ "Khấu hao", "Quảng cáo", để lọc trong báo cáo
  category  String
  amountVnd Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentAt])
}
