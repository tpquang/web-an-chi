generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  // Hướng dẫn chọn hiển thị dưới lưới sản phẩm, mỗi đoạn cách nhau một dòng trống
  guide           String?
  position        Int       @default(0)
  metaTitle       String?
  metaDescription String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  // Một câu ngắn hiện cạnh giá
  summary           String?
  description       String?
  usage             String?
  // Thông số dạng [{ "label": "Kích thước hạt", "value": "12mm" }]
  specs             Json?
  // Giá lưu bằng số nguyên VND
  priceVnd          Int
  compareAtPriceVnd Int?
  stock             Int            @default(0)
  // Xuất xứ, ví dụ "Khánh Hòa"; để trống khi chưa xác minh được
  origin            String?
  featured          Boolean        @default(false)
  // Link gian hàng của chính sản phẩm này trên sàn, để trống nếu không bán ở đó
  shopeeUrl         String?
  tiktokUrl         String?
  status            PublishStatus  @default(DRAFT)
  metaTitle         String?
  metaDescription   String?
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  orderItems        OrderItem[]
  posts             Post[]
  components        ProductComponent[]
  batchPlans        BatchPlan[]
  movements         StockMovement[]
  packRuns          PackRun[]
  // Giá vốn bình quân mỗi sản phẩm đã đóng gói, cập nhật mỗi lần đóng gói
  unitCostVnd       Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model PostCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  position        Int      @default(0)
  metaTitle       String?
  metaDescription String?
  posts           Post[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Post {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  // Văn bản thuần: đoạn cách nhau một dòng trống, "## " là H2, "### " là H3, "- " là gạch đầu dòng
  content         String
  coverUrl        String?
  authorName      String
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  categoryId      String
  category        PostCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Sản phẩm liên quan hiện cuối bài
  products        Product[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  // Khoá nhận diện khách đặt hàng không cần tài khoản
  phone            String   @unique
  email            String?
  address          String?
  // Chỉ true khi khách tự đánh dấu đồng ý nhận tin
  marketingConsent Boolean  @default(false)
  // null: khách chỉ đặt hàng, chưa tạo tài khoản. Dạng "scrypt$<salt>$<hash>"
  passwordHash     String?
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id             String        @id @default(cuid())
  code           String        @unique
  // Client gửi kèm mỗi lần đặt để bấm hai lần không tạo hai đơn
  idempotencyKey String?       @unique
  // Thông tin giao hàng lưu theo đơn, không đổi khi khách cập nhật hồ sơ
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String
  note           String?
  subtotalVnd    Int
  shippingVnd    Int
  totalVnd       Int
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  status         OrderStatus   @default(PENDING)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id           String   @id @default(cuid())
  // Lưu lại tên và giá lúc đặt để đơn cũ không đổi khi sản phẩm thay đổi hoặc bị xóa
  productName  String
  unitPriceVnd Int
  quantity     Int
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// Cấu hình cửa hàng dạng khoá - giá trị, ví dụ "store" chứa thông tin liên hệ, tài khoản ngân hàng
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---- Kho và đợt nhập hàng
// Nhập nguyên liệu thô (nụ, hộp, túi...), đóng gói theo công thức thành sản phẩm bán (Product.stock).
// Mọi thay đổi tồn kho ghi vào StockMovement. Số lượng tính theo đơn vị gốc của nguyên liệu.

model Material {
  id          String              @id @default(cuid())
  name        String              @unique
  // Đơn vị gốc: viên, cái, gam...
  unit        String
  // Quy đổi để nhập theo kg, ví dụ 800 viên mỗi kg. Để trống nếu không nhập theo kg
  unitsPerKg  Int?
  stock       Int                 @default(0)
  // Giá vốn bình quân mỗi đơn vị, cập nhật mỗi lần nhập kho
  avgCostVnd  Float               @default(0)
  note        String?
  components  ProductComponent[]
  lines       PurchaseLine[]
  writeOffs   BatchWriteOff[]
  movements   StockMovement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// Công thức đóng gói: một sản phẩm bán gồm bao nhiêu đơn vị của từng nguyên liệu
model ProductComponent {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Int
  position   Int      @default(0)

  @@unique([productId, materialId])
}

enum BatchStatus {
  PLANNED
  ORDERED
  RECEIVED
}

model PurchaseBatch {
  id          String          @id @default(cuid())
  name        String
  supplier    String?
  orderedAt   DateTime?
  receivedAt  DateTime?
  status      BatchStatus     @default(PLANNED)
  // Vốn đang có cho đợt này, để so với vốn cần
  capitalVnd  Int?
  // Phí bán ước tính trên doanh thu (sàn, thanh toán), phần trăm
  feePct      Float           @default(0)
  note        String?
  lines       PurchaseLine[]
  extras      PurchaseExtra[]
  writeOffs   BatchWriteOff[]
  plans       BatchPlan[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([createdAt])
}

// Một dòng nguyên liệu trong đợt nhập
model PurchaseLine {
  id           String        @id @default(cuid())
  batchId      String
  batch        PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  position     Int           @default(0)
  // Số lượng theo đơn vị gốc của nguyên liệu
  quantity     Int
  // Thành tiền của dòng
  totalCostVnd Int
  // Chỉ để hiển thị lại khi nhập theo kg
  inputKg      Float?
  pricePerKgVnd Int?

  @@index([batchId, position])
}

// Chi phí phát sinh của đợt nhập: ship nhập, thuế... chia vào giá vốn theo tỉ lệ tiền hàng
model PurchaseExtra {
  id        String        @id @default(cuid())
  batchId   String
  batch     PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position  Int           @default(0)
  label     String
  amountVnd Int

  @@index([batchId, position])
}

// Hao hụt khi nhận hàng: móp, vỡ, ẩm, tiêu huỷ. Không vào kho, chi phí dồn vào phần còn lại
model BatchWriteOff {
  id         String        @id @default(cuid())
  batchId    String
  batch      PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId String
  material   Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Int
  reason     String
  position   Int           @default(0)
}

// Dự kiến đóng bao nhiêu thành phẩm từ đợt nhập, để tính lợi nhuận trước khi nhập kho
model BatchPlan {
  id        String        @id @default(cuid())
  batchId   String
  batch     PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([batchId, productId])
}

enum MovementType {
  PURCHASE
  WRITE_OFF
  PACK_CONSUME
  PACK_PRODUCE
  ADJUST
}

// Sổ kho: quantity dương là tăng, âm là giảm
model StockMovement {
  id          String         @id @default(cuid())
  type        MovementType
  materialId  String?
  material    Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Int
  unitCostVnd Float          @default(0)
  batchId     String?
  batch       PurchaseBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  packRunId   String?
  packRun     PackRun?       @relation(fields: [packRunId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([materialId, createdAt])
  @@index([productId, createdAt])
}

// Một lần đóng gói thành phẩm
model PackRun {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitCostVnd Float
  note        String?
  movements   StockMovement[]
  createdAt   DateTime        @default(now())

  @@index([createdAt])
}
